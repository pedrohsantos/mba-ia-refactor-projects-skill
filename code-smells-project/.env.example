# Copie para .env e ajuste. Nunca commite o .env.
SECRET_KEY=
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
CORS_ORIGINS=*
DATABASE_PATH=loja.db
# Token exigido no header X-Admin-Token das rotas /admin/*. Vazio = rotas admin desabilitadas (403).
ADMIN_TOKEN=
# Senha dos usuários de exemplo criados no primeiro boot. Vazio = senha aleatória.
SEED_USER_PASSWORD=
