# Copie para .env e exporte as variáveis antes de `npm start` (ou use `node --env-file=.env src/app.js`).
NODE_ENV=development
PORT=3000
DATABASE_FILE=:memory:
PAYMENT_GATEWAY_KEY=
# Token exigido no header X-Admin-Token das rotas administrativas. Vazio = rotas desabilitadas (403).
ADMIN_TOKEN=
# Senha do usuário seed (Leonan). Vazio = senha aleatória.
SEED_USER_PASSWORD=
