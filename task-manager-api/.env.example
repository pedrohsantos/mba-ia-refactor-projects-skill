# Copie para .env e ajuste. Nunca commite o .env.
SECRET_KEY=
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
CORS_ORIGINS=*
DATABASE_URL=sqlite:///tasks.db
AUTH_TOKEN_MAX_AGE_SECONDS=86400
# Senha dos usuários criados pelo seed.py. Vazio = senha aleatória.
SEED_USER_PASSWORD=
# Notificações por e-mail (desabilitadas se vazio)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
